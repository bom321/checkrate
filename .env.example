# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง — ห้าม commit .env เข้า git

# ── SMTP (ส่งอีเมลแจ้งเตือน) — ชุดหลัก: Gmail ──
# Gmail: เปิด 2FA ก่อน แล้วสร้าง App Password ที่ https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_FROM=your_email@gmail.com

# ผู้รับเริ่มต้น (คั่นหลายคนด้วย , ) — แก้ภายหลังผ่านหน้าเว็บได้ (จะถูกเก็บใน settings.json แทน)
# อีเมลที่ส่งหาคนหลายคนตามรายชื่อนี้ (แจ้งประกาศใหม่ / error / ทดสอบ) ส่งแบบ **BCC** เสมอ
# ผู้รับแต่ละคนจึงไม่เห็นอีเมลของคนอื่นในรายชื่อ (ยกเว้นอีเมลรหัส OTP เข้าสู่ระบบ ที่จ่าหน้าถึงคนคนนั้นตรง ๆ)
EMAIL_TO=you@example.com

# เพดานขนาดไฟล์ PDF ประกาศที่แนบไปกับอีเมลแจ้งประกาศใหม่ (MB, ไม่ตั้ง = 15)
# ประกาศปกติอยู่ที่ ~0.1-1.6MB (BBL เป็นภาพสแกนจึงใหญ่สุด) — ตั้งค่านี้ให้ต่ำกว่าเพดานของผู้ให้บริการ
# อีเมลที่ใช้อยู่ ไฟล์ที่เกินเพดานจะ "ไม่ถูกแนบ" แต่อีเมลยังส่งตามปกติ (เนื้อความจะบอกชื่อไฟล์แทน)
# EMAIL_ATTACH_MAX_MB=15

# ── SMTP สำรอง: Synology MailPlus ──
# สลับใช้งานได้จากหน้า /config (เลือก "MailPlus (Synology)") — เก็บเป็นคีย์ email_provider ใน settings.json
# ต่อตรงไปยังกล่อง Synology (MailPlus รีเลย์ต่อไปยัง Brevo เองข้างใน ฝั่งนี้ไม่ต้องรู้เรื่อง Brevo)
SMTP2_HOST=mail.example.synology.me
SMTP2_PORT=465            # 465=SSL, 587=STARTTLS — ดูค่าจริงจากหน้าตั้งค่า MailPlus
SMTP2_USER=checkrate@example.com
SMTP2_PASSWORD=
SMTP2_FROM=                # เว้นว่าง = ใช้ SMTP2_USER
# ถ้าเจอ SSLCertVerificationError (ใบรับรองของกล่อง Synology มักเป็น self-signed หรือ hostname
# ไม่ตรงเวลาต่อผ่าน LAN IP) ทางที่ดีที่สุดคือตั้ง SMTP2_CA_FILE ชี้ไปใบรับรองจริง — ยัง verify
# เข้ม เพียงแต่บอกว่าให้เชื่อใบรับรองนี้เพิ่ม (export จาก DSM: Control Panel → Security →
# Certificate → เลือกใบที่ MailPlus ใช้ → Export → เก็บไฟล์ .crt/.pem ไว้แล้วชี้ path มาที่นี่)
# SMTP2_CA_FILE=/path/to/synology-ca.pem
# SMTP2_INSECURE คือทางเลือกสุดท้าย (ปิดการตรวจสอบใบรับรองทั้งดุ้น) ใช้เฉพาะตั้ง CA_FILE ไม่ได้จริง ๆ
# ลำดับความสำคัญ: SMTP2_CA_FILE > SMTP2_INSECURE > ปกติ (verify เต็ม)
SMTP2_INSECURE=0

# ── เว็บ ──
WEB_HOST=0.0.0.0
# พอร์ตที่ uvicorn ฟัง **ข้างในคอนเทนเนอร์** (docker-compose.yml ใช้ค่านี้เป็นฝั่งขวาของ ports: ด้วย)
WEB_PORT=8080
# พอร์ตฝั่ง host ที่จะเปิดออกไปให้เข้าเว็บ — ตั้งเฉพาะเมื่อ 8080 บน NAS ชนกับบริการอื่น
# ค่านี้คือตัวที่ใส่ใน URL: http://<ip ของ NAS>:<HOST_WEB_PORT>  (ไม่ตั้ง = 8080)
# ⚠️ ถ้าเปลี่ยน WEB_PORT ข้างบน **ต้องตั้งค่านี้ให้ตรงกันด้วย** — ไม่ตั้งแล้วมันจะกลับไปเป็น 8080
#    ทั้ง docker-compose.yml และ scripts/update.sh (compose v1 ไม่รองรับ default ซ้อนชั้น)
# HOST_WEB_PORT=8080

# ── Admin login (OTP ทางอีเมล) ──
# อีเมลที่มีสิทธิ์เข้า /config, /logs และกดปุ่มรันตรวจสอบ — คั่นหลายคนด้วย ,
# คนอื่น (ไม่ login หรือ login ด้วยอีเมลนอกรายชื่อนี้) ดูได้แค่หน้าภาพรวมกับหน้ารายละเอียดธนาคาร
ADMIN_EMAILS=you@example.com

# secret สำหรับเซ็น session cookie — แนะนำให้ตั้งเองเสมอ (ไม่ตั้ง ระบบจะ generate เก็บไว้ที่
# {DATA_DIR}/.session_secret ให้แทน แต่โฟลเดอร์นั้นมักเข้าถึงได้ผ่าน SMB/File Station บน NAS —
# ใครอ่านไฟล์นั้นได้ก็ปลอม session cookie เป็น admin ได้โดยไม่ต้องผ่าน OTP เลย)
# generate ด้วย: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# ตั้ง 1 เฉพาะเมื่อเปิดเว็บผ่าน HTTPS จริง (reverse proxy/Cloudflare Tunnel) — เพิ่ม flag Secure
# ให้ session cookie ไม่งั้นเบราว์เซอร์จะไม่ยอมส่ง cookie เลยเวลาเข้าผ่าน HTTP ธรรมดาบน LAN
# COOKIE_SECURE=1
# อายุ session cookie เป็นวัน (ค่าเริ่มต้น 7)
# SESSION_MAX_AGE_DAYS=7

# ── คำขอจากผู้ใช้ทั่วไป (POST /api/request) ──
# ตั้ง 1 เฉพาะเมื่ออยู่หลัง reverse proxy/Docker เท่านั้น (ไม่งั้น rate-limit จะเหมารวมทั้งเว็บ
# เพราะเห็นทุกคำขอเป็น IP proxy ตัวเดียว) — ต้องมั่นใจว่า proxy ข้างหน้าล้าง X-Forwarded-For เดิม
# ทิ้งก่อนเสมอ (ไม่งั้น client ปลอมค่าได้)
# TRUST_PROXY=1
# จำนวน proxy ที่เชื่อถือได้ระหว่างเรากับอินเทอร์เน็ต (ค่าเริ่มต้น 1 = reverse proxy ตัวเดียว)
# TRUSTED_PROXY_HOPS=1
# REQUEST_MAX_PER_HOUR=5

# ── NAS / Docker ──
# uid:gid ที่คอนเทนเนอร์ใช้รัน (ค่าเริ่มต้น 1000 = ผู้ใช้ app ใน image) — ต้องเขียน HOST_DATA_DIR ได้
# บน Synology ที่โฟลเดอร์เปิด ACL ไว้ (`ls -nd` ขึ้น `+` ท้าย mode) ตัวที่บังคับใช้จริงคือ ACL ไม่ใช่
# POSIX bits ที่ `ls` โชว์ — ACL ให้สิทธิ์เป็นราย "ผู้ใช้ DSM" ซึ่ง uid เริ่มที่ 1024 ไม่ใช่ 1000
# `chown -R 1000:1000` จึงไม่ช่วย (พิสูจน์แล้ว ส.ค. 2569) ต้องตั้งสองค่านี้ให้ตรงกับผู้ใช้ DSM แทน
# **ห้ามคัดลอกตัวเลขข้างล่างไปใช้ตรง ๆ** — ดูค่าจริงของเครื่องตัวเองเสมอด้วย: id <ชื่อผู้ใช้ DSM>
# (ค่าที่ใช้จริงบน NAS ตอนนี้: bom321 = uid 1027, กลุ่ม users = gid 100)
# PUID=1027
# PGID=100
# path บน NAS ที่จะ map เข้า /data ใน container (CSV/PDF/log/config เก็บที่นี่ ปรับได้ตามต้องการ)
# ต้องเป็น path เต็มของโฟลเดอร์ข้อมูลเอง ไม่ใช่โฟลเดอร์โปรเจกต์ — ค่าที่ใช้จริงบน NAS ตอนนี้คือ
# โฟลเดอร์ data/ ที่อยู่ในโปรเจกต์ (ปลอดภัยเพราะติดทั้ง .gitignore และ .dockerignore)
HOST_DATA_DIR=/volume1/bom321/Work/deposit-rate/docker/checkrate/data

# token สำหรับถาม GitHub ว่า CI ของ commit ที่จะ deploy เขียวหรือยัง (scripts/update.sh ขั้น 2.5)
# **ตอนนี้ไม่ต้องตั้ง** — repo เป็น public จึงยิง API แบบไม่มี token ได้ (โควตา 60 req/ชม./IP พอเหลือ)
# จำเป็นเมื่อ repo ถูกเปลี่ยนเป็น private (ไม่งั้น API ตอบ 404 แล้วประตู CI จะข้ามไปเงียบ ๆ) หรือเมื่อ
# ชน rate limit — ใช้ fine-grained PAT สิทธิ์แค่ Contents: read + Checks: read ผูกกับ repo นี้ตัวเดียวพอ
# GITHUB_TOKEN=

TZ=Asia/Bangkok
